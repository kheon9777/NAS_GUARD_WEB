[Unit]
Description=guard web console (FastAPI)
After=network-online.target guard.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/raspi/sv/guard_web
ExecStart=/home/raspi/sv/guard_web/.venv/bin/python -m app
# 일반 계정으로 실행. guard.db는 raspi 소유(deploy.sh가 chown), guard 리로드는 sudoers(deploy/guard_web.sudoers)로 허용한
# systemctl reload guard 만 sudo로 부른다
User=raspi
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
